# ---- umumiy ----
ENVIRONMENT=dev                      # dev | test | staging | prod
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000
TIMEZONE=Asia/Tashkent

# ---- ma'lumotlar bazasi ----
# Dev: SQLite (Docker shart emas). Prod: PostgreSQL (O'zbekiston hududidagi DC).
DATABASE_URL=sqlite+aiosqlite:///./data/lexlab.db
# DATABASE_URL=postgresql+asyncpg://lexlab:lexlab@localhost:5432/lexlab
# REDIS_URL=redis://localhost:6379/0

# ---- xavfsizlik (prod'da ALBATTA almashtiring) ----
JWT_SECRET=change-me-in-production-please-32b+
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcyEhISE=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Faqat dev/test: SMS o'rniga doimiy kod
OTP_DEV_FIXED_CODE=111111

# ---- fayl saqlash ----
STORAGE_BACKEND=local                # local | s3
STORAGE_LOCAL_ROOT=./data/storage
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=lexlab
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# ---- integratsiyalar ----
SMS_BACKEND=console                  # console | eskiz
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546
# ONEID_CLIENT_ID=
# ONEID_CLIENT_SECRET=
# ONEID_REDIRECT_URI=
# E-IMZO-SERVER (rasmiy komponent; /backend/* faqat ichki tarmoqdan ochiq bo'lsin)
# EIMZO_SERVER_URL=http://127.0.0.1:8080
# EIMZO_SITE_HOST=lexlab.uz
# EIMZO_REQUIRE_TIMESTAMP=true
# TELEGRAM_BOT_TOKEN=
# SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_LANGS=uzb+uzb_cyrl+rus

# ---- fon vazifalar / eslatmalar ----
SCHEDULER_MODE=inprocess             # inprocess | worker | off
REMINDER_OFFSETS_DAYS=6,3,2,1,0
REMINDER_SEND_HOUR=9
WORK_WEEK_DAYS=0,1,2,3,4

# ---- blokcheyn (faqat Merkle ildizi zanjirga yoziladi; ma'lumotlar O'zbekistonda qoladi) ----
ANCHOR_BACKEND=disabled              # disabled | evm
# ANCHOR_NETWORK=polygon-amoy
# EVM_RPC_URL=https://rpc-amoy.polygon.technology
# EVM_CHAIN_ID=80002
# ANCHOR_CONTRACT_ADDRESS=           # python -m app.modules.anchoring.deploy
# RELAYER_PRIVATE_KEY=               # python -m app.modules.anchoring.deploy --new-key  (SIR! git'ga qo'ymang)
# ANCHOR_CONFIRMATIONS=3
# ANCHOR_EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/{tx}

# ---- web frontend: shu papkadagi index.html API bilan bir manzilda (/) ochiladi ----
# FRONTEND_DIR=../../apps/web
# OTP_IP_HOURLY_LIMIT=20

# ---- AI (OpenAI-compatible). Lokal Qwen (Ollama) — tavsiya etiladi:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_IS_LOCAL=true
# DeepSeek (faqat dev; matn maskalanadi, prodda taqiqlangan):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_IS_LOCAL=false
# LLM_API_KEY=
