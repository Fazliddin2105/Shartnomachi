        "muddat",
        "срок"
      ]
    },
    {
      "code": "dispute",
      "title": "Nizolarni hal qilish tartibi",
      "patterns": [
        "nizo",
        "спор",
        "sud tartibida",
        "sudda hal",
        "в судебном порядке",
        "арбитраж"
      ],
      "suggestion": "Nizolar muzokara, so'ngra sud tartibida hal qilinishi haqidagi bandni qo'shing."
    }
  ],
