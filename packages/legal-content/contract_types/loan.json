      "code": "fk2",
      "number": "733"
    },
    {
      "law_ref": "FK 734-modda. Qarz shartnomasi boʻyicha foizlar",
      "lex_url": "https://lex.uz/uz/docs/-180552#-190130",
      "code": "fk2",
      "number": "734"
    },
    {
      "law_ref": "FK 735-modda. Qarz oluvchining qarz summasini qaytarish majburiyati",
      "lex_url": "https://lex.uz/uz/docs/-180552#-190167",
      "code": "fk2",
      "number": "735"
    },
    {
      "law_ref": "FK 736-modda. Qarz oluvchi tomonidan qarz shartnomasini buzish oqibatlari",
      "lex_url": "https://lex.uz/uz/docs/-180552#-190181",
      "code": "fk2",
      "number": "736"
    },
    {
      "law_ref": "FK 245-modda. Pul majburiyatlarining valyutasi",
      "lex_url": "https://lex.uz/uz/docs/-111189#-5446086",
      "code": "fk1",
      "number": "245"
    },
    {
      "law_ref": "FK 326-modda. Neustoykani kamaytirish",
